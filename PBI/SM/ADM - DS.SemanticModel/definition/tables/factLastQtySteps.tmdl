table factLastQtySteps
	lineageTag: 62a21308-f62b-40c3-9690-9c0d6e1d6561

	/// Units behind each step. Equals the step unless the article's whole priced history is shorter. Shared by all three price views.
	measure 'Total Last Qty Quantity' = SUM(factLastQtySteps[Qty])
		formatString: #,0.##
		displayFolder: Last Qty Steps
		lineageTag: 7c4c389b-997e-4ede-ae27-b0e650974024

	/// Total USD value of the last N priced units, for the selected price view (PriceType slicer: 1=Order, 2=CIF, 3=FOT).
	measure 'Total Last Qty Value' =
			SWITCH(MIN(PriceType[ID]),
			    2, SUM(factLastQtySteps[ValueCIFUSD]),
			    3, SUM(factLastQtySteps[ValueFOTUSD]),
			       SUM(factLastQtySteps[ValueOrderUSD]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Last Qty Steps
		lineageTag: c0d95e92-1542-4d1b-9f19-6872bda41c88

	/// Quantity-weighted average price of the last N units sold, pooled across the article.
	/// CAVEAT: the divisor is the Order-view unit count for all three views. Where a CIF or FOT
	/// price is missing on some rows, that view covers fewer units than the divisor counts and is
	/// therefore understated. Currently affects Oils (FOT) only; BPP has no CIF prices at all.
	measure 'AVG Last Qty Price' = DIVIDE([Total Last Qty Value], [Total Last Qty Quantity])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Last Qty Steps
		lineageTag: cd2a1a6d-0ff3-440b-af86-9a14cee4de64

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Corn-defaulting wrapper, matching the neighbouring Risk Plan measures. Bind this one in the visual.
	measure 'AVG Last Qty Price - Risk Plan' =
			VAR _n = COUNTROWS(VALUES(dimArticle[Article]))
			RETURN
			IF(
			    _n = 1,
			    [AVG Last Qty Price],
			    CALCULATE([AVG Last Qty Price], dimArticle[Article] = "Corn")
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Last Qty Steps
		lineageTag: e45d3a84-ffcb-45d1-b951-33fc8efccfc4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Oldest order date the step reaches back to (Order price view).
	measure 'Last Qty Tail Anchor' = MIN(factLastQtySteps[BoundaryOrderDate])
		formatString: dd/mm/yyyy
		displayFolder: Last Qty Steps
		lineageTag: 5fb4733e-f9a7-4fa9-917f-cde04b65d767

	/// Flags a step whose units fall short of its nominal size, i.e. the article's
	/// entire priced history is smaller than the step. Blank on full steps so it
	/// only appears where it matters.
	measure 'Last Qty Step Note' =
			VAR _short = SELECTEDVALUE(factLastQtySteps[StepStatus]) = "Partial"
			VAR _qty   = [Total Last Qty Quantity]
			VAR _step  = SELECTEDVALUE(factLastQtySteps[Step])
			RETURN
			IF(_short, "only " & FORMAT(_qty, "#,0") & " of " & FORMAT(_step, "#,0"))
		displayFolder: Last Qty Steps
		lineageTag: dc6e3404-afb7-42ae-808a-febd7f81c4e5

	column Article
