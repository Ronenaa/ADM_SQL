 > 0 #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)THEN ((ROUND(OP.OriginalQty/OP.QtyTonePerContract,0)-ISNULL(bc.Totalcontracts,0))/ROUND(OP.OriginalQty/OP.QtyTonePerContract,0))*HZ.CMOT_MOZMNT ---- כמות שלא תומחרה =כמות הזמנה כפול(סך הכל חוזים אפשריים - חוזים שנחתמו חלקי סך כל החוזים האפשריים#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE POB.Balance#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab)#(tab)#(tab)WHEN t.PO_Family = 1#(lf)#(tab)#(tab)#(tab)#(tab)Then Null#(lf)#(tab)#(tab)#(tab)ELSE NULL#(lf)#(tab)#(tab)END AS BasisQTY#(lf)#(tab)#(tab),CASE #(lf)#(tab)#(tab)#(tab)WHEN POB.Balance IS NULL THEN HZ.CMOT_MOZMNT#(lf)#(tab)#(tab)#(tab)WHEN HZ.OrderStatus = 4 or HZ.OrderStatus = 5#(lf)#(tab)#(tab)#(tab)#(tab)Then POB.Balance#(lf)#(tab)#(tab)#(tab)WHEN t.PO_Family = 2#(lf)#(tab)#(tab)#(tab)#(tab)THEN CASE#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)WHEN isNULL(ROUND(OP.OriginalQty/OP.QtyTonePerContract,0),0) > 0 #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)THEN (ISNULL(bc.Totalcontracts,0)/ROUND(OP.OriginalQty/OP.QtyTonePerContract,0))*HZ.CMOT_MOZMNT ---- כמות שתומחרה =כמות הזמנה כפול חוזים שנחתמו חלקי סך כל החוזים האפשריים#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)ELSE NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab)#(tab)#(tab)WHEN t.PO_Family = 1#(lf)#(tab)#(tab)#(tab)#(tab)Then POB.Balance#(lf)#(tab)#(tab)#(tab)ELSE  POB.Balance#(lf)#(tab)#(tab)END AS FlatQTY#(lf)#(tab)#(tab)--,bc.TotalContracts as ContractSigned#(lf)#(tab)#(tab),POL_StockExchangeDate#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)#(tab)#(tab),sf.PF_GeneralFactor#(lf)#(tab)#(tab),POL_PremiumPrice#(lf)#(tab)#(tab),POL_StockMarketPrice#(lf)#(tab)#(tab),smp.SMP_Symbol#(lf)#(tab)#(tab),CAST (smpe.SMPE_TempPrice as float) as SMPE_TempPrice#(lf)#(tab)#(tab),ACT.TAOR_AOPTSIH as OrderType#(lf)#(tab)#(tab),POL.POL_StockMarketTempPriceForNoneClosed as MarketTempPrice#(lf)#(tab)#(tab),POL_FinalPriceForClosedContract#(tab)#(tab)#(tab)as FinalPriceClosedContract#(lf)#(lf)#(tab)#(tab),OP.CFFlat#(lf)#(tab)#(tab),OP.CFFLAT_CC#(lf)#(tab)#(tab),OP.CFFLAT_NCC#(lf)#(tab)#(tab),OP.FotPrice#(lf)#(tab)#(tab),OP.FOT_CC#(lf)#(tab)#(tab),OP.FOT_NCC#(lf)#(tab)#(tab),OP.OriginalQty#(lf)#(tab)#(tab),OP.DollarRate#(lf)#(tab)#(tab),POL.POL_StockMarketTempPriceForNoneClosed#(lf)#(tab)#(tab),GETDATE() AS RowInsertDatetime#(lf)FROM [HZMNOT] HZ#(lf)LEFT JOIN (#(lf)           SELECT *, #(lf)                    CASE#(lf)                    #(tab)WHEN sher = 0#(lf)                    #(tab)THEN FIRST_VALUE(sher) OVER (PARTITION BY value_partition ORDER BY Tarikh) #(lf)                    #(tab)ELSE sher#(lf)                    END AS new_sher#(lf)            FROM (#(lf)                     SELECT *#(lf)#(tab)#(tab)#(tab)#(tab)#(tab) ,SUM(CASE WHEN sher=0 THEN 0 ELSE 1 END) OVER (ORDER BY tarikh ) AS value_partition#(lf)                     FROM SHERI_MTBE) m#(lf)           #(lf)           ) SM #(lf)ON SM.TARIKH=HZ.T_HZMNH#(lf)Left Join OrderPrices OP#(lf)#(tab)ON op.OrderID = Hz.MSPR_HZMNH#(lf)LEFT JOIN PurchaseOrderTypes t#(lf)#(tab)ON t.PO_TypeID = OP.ActionType#(lf)Left Join BasisContract bc#(lf)#(tab)ON op.OrderID = bc.ID#(lf)----#(lf)left join SalesOrder2Purchase sol#(lf)#(tab)on HZ.MSPR_HZMNH = sol.POSO_SOID#(lf)left join PurchaseOrderLines POL#(lf)#(tab)on sol.POSO_POID = pol.POL_OrderID and sol.POSO_POLID = pol.POL_LineID#(lf)left join ProductStockMarketFactors sf#(lf)#(tab)on pol.POL_ProductID = sf.PF_ProductID and POL.POL_FactorCode = sf.PF_FactorID #(lf)left join StockMarketProduct smp#(lf)#(tab)on POL.POL_ProductID = smp.SMP_ProductID AND MONTH(POL.POL_StockExchangeDate) = smp.SMP_MonthID#(lf)left join SMPE as smpe --(select * from SMPE where  rownum = 1) smpe#(lf)#(tab)on POL.POL_ProductID = smpe.SMPE_ProductID AND YEAR(POL.POL_StockExchangeDate) = smpe.SMPE_Year AND MONTH(POL.POL_StockExchangeDate) = smpe.SMPE_Month#(lf)Left Join viewPurchaseOrderBalance POB#(lf)#(tab)ON POL.POL_OrderID = POB.POID AND POL.POL_LineID = POB.POLineID#(lf)LEFT JOIN TBLT_PEOLOT_HZMNH_T_MSHLOCH ACT#(lf)#(tab)ON HZ.actionType = ACT.MS_AOPTSIH#(lf)#(lf)WHERE Cast(SUBSTRING(T_HZMNH,1,4) as int) >=2018 and Cast(SUBSTRING(T_HZMNH,1,4) as int) <= Year(Getdate())#(lf)AND HZ.OrderStatus<>3#(lf)AND HZ.ActionType IN (1,11,12,14)--NOT IN (2,6,7,10/*,11*/)#(lf)#(lf)--AND HZ.MSPR_HZMNH IN ('139761')--,'136892','136030','136532','137242', '135805')--'135671'-- '136227' --'133900'#(lf)--AND SUBSTRING(HZ.T_ASPQH,1,4) = 2025 AND SUBSTRING(HZ.T_ASPQH,5,2) = 01#(lf))#(lf),ordersBase as (#(lf)SELECT#(tab)o.*#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(lf)#(tab)#(tab),CASE #(lf)#(tab)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN o.FlatQTY * FinalPriceClosedContract#(lf)#(tab)#(tab)#(tab)ELSE LineTotalBalanceUSD#(lf)#(tab)#(tab) END#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS LineTotalFlatBalanceUSD#(lf)#(tab)#(tab),CASE #(lf)#(tab)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN o.FlatQTY * FinalPriceClosedContract#(lf)#(tab)#(tab)#(tab)ELSE LineTotalNetUSD#(lf)#(tab)#(tab) END#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS LineTotalFlatUSD#(lf)#(tab)#(tab),CASE #(lf)#(tab)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN o.BasisQTY * MarketTempPrice#(lf)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab) END#(lf)#(tab)#(tab) +#(lf)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN o.FlatQTY * FinalPriceClosedContract#(lf)#(tab)#(tab)#(tab)ELSE LineTotalNetUSD#(lf)#(tab)#(tab) END#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS LineTotalFlatValueUSD#(lf)#(lf)    ,CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.CFFLAT_CC #(lf)        ELSE o.CFFlat #(lf)    END AS UnitPriceCF,#(lf)    #(lf)    -- Calculate LineTotalCF_USD using PremiumFlag and FlatQTY (or OriginalQty)#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.CFFLAT_CC * o.FlatQTY #(lf)        ELSE o.CFFlat * o.OriginalQty #(lf)    END AS LineTotalCF_USD,#(lf)    #(lf)    -- Calculate LineTotalCF_NIS (apply DollarRate to the above)#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.CFFLAT_CC * o.FlatQTY * o.DollarRate #(lf)        ELSE o.CFFlat * o.DollarRate * o.OriginalQty #(lf)    END AS LineTotalCF_NIS,#(lf)    #(lf)    -- Calculate UnitPriceFOT based on the PremiumFlag#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.FOT_CC #(lf)        ELSE o.FotPrice #(lf)    END AS UnitPriceFOT,#(lf)    #(lf)    -- Calculate LineTotalFOT_USD using PremiumFlag and FlatQTY (or OriginalQty)#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.FOT_CC * o.FlatQTY #(lf)        ELSE o.FotPrice * o.OriginalQty #(lf)    END AS LineTotalFOT_USD,#(lf)    #(lf)    -- Calculate LineTotalFOT_NIS (apply DollarRate to the above)#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.FOT_CC * o.FlatQTY * o.DollarRate #(lf)        ELSE o.FotPrice * o.DollarRate * o.OriginalQty #(lf)    END AS LineTotalFOT_NIS,#(lf)    #(lf)    -- Use BasisQTY to compute the flat value balance in USD#(lf)    CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN (o.POL_StockMarketTempPriceForNoneClosed * o.BasisQTY)+(o.FlatQTY * FinalPriceClosedContract) #(lf)#(tab)#(tab)ELSE LineTotalBalanceUSD#(lf)#(tab)#(tab)END AS LineTotalFlatValueBalanceUSD,#(lf)    #(lf)    -- Calculate MarketTempPriceCFF_USD and its related total using BasisQTY#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.CFFLAT_NCC #(lf)        ELSE NULL #(lf)    END AS MarketTempPriceCFF_USD,#(lf)    #(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN (o.CFFLAT_NCC * o.BasisQTY) + (o.FlatQTY * o.CFFLAT_NCC)#(lf)        ELSE QuantityLeft*o.CFFlat #(lf)    END AS LineTotalFlatValueBalanceCFFUSD,#(lf)#(tab)CASE #(lf)        WHEN o.PremiumFlag = 1 THEN (o.FlatQTY * o.CFFLAT_NCC)#(lf)        ELSE QuantityLeft*o.CFFlat #(lf)    END AS LineTotalFlatBalanceCFFUSD,#(lf)    #(lf)    -- Calculate MarketTempPriceFOT_USD and its related total using BasisQTY#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN o.FOT_NCC #(lf)        ELSE NULL #(lf)    END AS MarketTempPriceFOT_USD,#(lf)    #(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN  (o.FOT_NCC * o.BasisQTY) + (o.FlatQTY * o.FOT_NCC)--(o.FOT_NCC * o.BasisQTY)--#(lf)        ELSE QuantityLeft*o.FotPrice #(lf)    END AS LineTotalFlatValueBalanceFOTUSD,#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 THEN (o.FOT_NCC * o.FlatQTY)#(lf)        ELSE QuantityLeft*o.FotPrice #(lf)    END AS LineTotalFlatBalanceFOTUSD,#(lf)#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 #(lf)             THEN (o.CFFLAT_NCC * o.BasisQTY) + (o.CFFLAT_CC * o.FlatQTY)#(lf)        ELSE (o.CFFlat * o.OriginalQty)#(lf)    END AS LineTotalFlatValueCFFUSD,#(lf)    #(lf)    -- Combined calculation for FOT pricing#(lf)    CASE #(lf)        WHEN o.PremiumFlag = 1 #(lf)             THEN (o.FOT_NCC * o.BasisQTY) + (o.FOT_CC * o.FlatQTY)#(lf)        ELSE (o.FotPrice * o.OriginalQty)#(lf)    END AS LineTotalFlatValueFOTUSD,#(lf)#(lf)#(tab)-- Priced quantity: zeroed on rows whose paired price hasn't landed yet, so averages aren't diluted by unpriced rows#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN CASE WHEN ISNULL(FinalPriceClosedContract,0) = 0 THEN 0 ELSE o.Quantity END#(lf)#(tab)#(tab)ELSE CASE WHEN ISNULL(o.UnitNetPriceUSD,0) = 0 THEN 0 ELSE o.Quantity END#(lf)#(tab)END AS PricedQuantity,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 AND ISNULL(MarketTempPrice,0) <> 0 THEN o.BasisQTY#(lf)#(tab)#(tab)ELSE 0#(lf)#(tab)END AS PricedBasisQTY,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN CASE WHEN ISNULL(FinalPriceClosedContract,0) = 0 THEN 0 ELSE o.FlatQTY END#(lf)#(tab)#(tab)ELSE CASE WHEN ISNULL(o.UnitNetPriceUSD,0) = 0 THEN 0 ELSE o.FlatQTY END#(lf)#(tab)END AS PricedFlatQTY,#(lf)#(tab)-- CF-specific priced quantity: a row can have a valid Order/FOT price but a blank/zero CF price, so CF averages need their own zero-check#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN CASE WHEN ISNULL(o.CFFLAT_CC,0) = 0 THEN 0 ELSE o.Quantity END#(lf)#(tab)#(tab)ELSE CASE WHEN ISNULL(o.CFFlat,0) = 0 THEN 0 ELSE o.Quantity END#(lf)#(tab)END AS PricedQuantityCF,#(lf)#(tab)-- FOT-specific priced quantity: same idea for the FOT price view#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN CASE WHEN ISNULL(o.FOT_CC,0) = 0 THEN 0 ELSE o.Quantity END#(lf)#(tab)#(tab)ELSE CASE WHEN ISNULL(o.FotPrice,0) = 0 THEN 0 ELSE o.Quantity END#(lf)#(tab)END AS PricedQuantityFOT,#(lf)#(tab)-- Combined open-quantity (Basis+Flat as QuantityLeft on non-premium rows) zeroed per price type, to match LineTotalFlatValueBalanceCFFUSD/FOTUSD's own grain#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN CASE WHEN ISNULL(o.CFFLAT_NCC,0) = 0 THEN 0 ELSE o.BasisQTY+o.FlatQTY END#(lf)#(tab)#(tab)ELSE CASE WHEN ISNULL(o.CFFlat,0) = 0 THEN 0 ELSE o.QuantityLeft END#(lf)#(tab)END AS PricedOpenQtyCF,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN CASE WHEN ISNULL(o.FOT_NCC,0) = 0 THEN 0 ELSE o.BasisQTY+o.FlatQTY END#(lf)#(tab)#(tab)ELSE CASE WHEN ISNULL(o.FotPrice,0) = 0 THEN 0 ELSE o.QuantityLeft END#(lf)#(tab)END AS PricedOpenQtyFOT,#(lf)#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN o.[סטטוס] = 1 then 'Open Order'#(lf)#(tab)#(tab)else null#(lf)#(tab)END AS 'Open_Slicer'#(lf)#(lf)/*#(tab)#(tab),CASE#(lf)#(tab)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN o.LineTotalFlatValueBalanceCFFUSD + LineTotalCF_USD#(lf)#(tab)#(tab)#(tab)ELSE LineTotalCF_USD END#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS LineTotalFlatValueCFFUSD#(lf)#(tab)#(tab),CASE#(lf)#(tab)#(tab)#(tab)WHEN o.PremiumFlag = 1 THEN o.LineTotalFlatValueBalanceFOTUSD + LineTotalCF_USD#(lf)#(tab)#(tab)#(tab)ELSE LineTotalCF_USD END#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS LineTotalFlatValueFOTUSD#(lf)*/#(lf)#(lf)FROM Orders o#(lf)where 1=1#(lf)--and OrderID = 140452#(lf)--and BasisQTY is not null#(lf)--and BasisQTY <>0#(lf))#(lf)#(lf)-- Step 1: materialise the base exactly as v1 did (no join) - this is the fast path.#(lf)SELECT ItemKey, OrderID, [Date], OrderCreateTime,#(lf)       PricedQuantity, PricedQuantityCF, PricedQuantityFOT,#(lf)       LineTotalFlatValueUSD, LineTotalFlatValueCFFUSD, LineTotalFlatValueFOTUSD#(lf)INTO #raw FROM ordersBase;#(lf)#(lf)-- Step 2: attach the Article and drop unmapped items.#(lf)SELECT am.Article_Description AS Article, r.OrderID, r.[Date], r.OrderCreateTime,#(lf)       r.PricedQuantity, r.PricedQuantityCF, r.PricedQuantityFOT,#(lf)       r.LineTotalFlatValueUSD, r.LineTotalFlatValueCFFUSD, r.LineTotalFlatValueFOTUSD#(lf)INTO #ob#(lf)FROM #raw r#(lf)JOIN #am am ON am.ItemKey = r.ItemKey#(lf)WHERE am.Article_Description <> 'Other';#(lf)CREATE CLUSTERED INDEX ix_ob ON #ob(Article, OrderCreateTime DESC, OrderID DESC);#(lf)#(lf)WITH Steps as (#(lf)    SELECT TOP (20)#(lf)           500 * CAST(ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS int) AS Step#(lf)    FROM sys.all_objects#(lf))#(lf)#(lf)/* One tail per (Article, price type). Pooled across every ItemKey in the#(lf)   Article, so ""last 500 of Corn"" is 500 units, not 500 per item. */#(lf),OrdersLong as (#(lf)    SELECT 1 AS PriceTypeID, Article, OrderID, [Date], OrderCreateTime,#(lf)           PricedQuantity AS PricedQty, LineTotalFlatValueUSD AS LineValueUSD#(lf)    FROM #ob#(lf)    UNION ALL#(lf)    SELECT 2, Article, OrderID, [Date], OrderCreateTime, PricedQuantityCF, LineTotalFlatValueCFFUSD FROM #ob#(lf)    UNION ALL#(lf)    SELECT 3, Article, OrderID, [Date], OrderCreateTime, PricedQuantityFOT, LineTotalFlatValueFOTUSD FROM #ob#(lf))#(lf)#(lf),Priced as (#(lf)    SELECT PriceTypeID, Article, OrderID, [Date], OrderCreateTime, PricedQty, LineValueUSD,#(lf)           LineValueUSD / PricedQty AS UnitPriceUSD#(lf)    FROM OrdersLong#(lf)    WHERE ISNULL(PricedQty, 0) > 0 AND LineValueUSD IS NOT NULL#(lf))#(lf)#(lf),Tail as (#(lf)    SELECT p.*,#(lf)           ISNULL(SUM(p.PricedQty) OVER (PARTITION BY p.PriceTypeID, p.Article#(lf)                ORDER BY p.OrderCreateTime DESC, p.OrderID DESC#(lf)                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING), 0) AS RunQtyBefore,#(lf)           SUM(p.PricedQty) OVER (PARTITION BY p.PriceTypeID, p.Article#(lf)                ORDER BY p.OrderCreateTime DESC, p.OrderID DESC#(lf)                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)     AS RunQtyAfter,#(lf)           ISNULL(SUM(p.LineValueUSD) OVER (PARTITION BY p.PriceTypeID, p.Article#(lf)                ORDER BY p.OrderCreateTime DESC, p.OrderID DESC#(lf)                ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING), 0) AS RunValBefore#(lf)    FROM Priced p#(lf))#(lf)#(lf),TailPruned as ( SELECT * FROM Tail WHERE RunQtyBefore < 10000 )#(lf)#(lf),TailTotal as (#(lf)    SELECT PriceTypeID, Article,#(lf)           MAX(RunQtyAfter)                 AS TotalQty,#(lf)           MAX(RunValBefore + LineValueUSD) AS TotalValue#(lf)    FROM Tail GROUP BY PriceTypeID, Article#(lf))#(lf)#(lf)/* Long form: one row per (Article, Step, price type). Pivoted below. */#(lf),Stepped as (#(lf)    SELECT k.Article, k.PriceTypeID, s.Step,#(lf)           CASE WHEN b.OrderID IS NULL THEN tt.TotalQty ELSE s.Step END AS Qty,#(lf)           CASE WHEN b.OrderID IS NULL THEN tt.TotalValue#(lf)                ELSE b.RunValBefore + (s.Step - b.RunQtyBefore) * b.UnitPriceUSD#(lf)           END AS Val,#(lf)           b.OrderID          AS BoundaryOrderID,#(lf)           b.[Date]           AS BoundaryOrderDate,#(lf)           b.OrderCreateTime  AS BoundaryOrderCreateTime,#(lf)           CASE WHEN b.OrderID IS NULL THEN NULL#(lf)                ELSE s.Step - b.RunQtyBefore END AS BoundaryQtyTaken#(lf)    FROM (SELECT DISTINCT PriceTypeID, Article FROM TailPruned) k#(lf)    JOIN Steps s ON 1 = 1#(lf)    LEFT JOIN TailPruned b#(lf)           ON b.PriceTypeID = k.PriceTypeID AND b.Article = k.Article#(lf)          AND b.RunQtyBefore < s.Step AND b.RunQtyAfter >= s.Step#(lf)    LEFT JOIN TailTotal tt#(lf)           ON tt.PriceTypeID = k.PriceTypeID AND tt.Article = k.Article#(lf))#(lf)#(lf)/* Pivot the three price types onto one row per (Article, Step).#(lf)   Each keeps its own tail, so quantities can differ where a price is missing. */#(lf)SELECT#(lf)     Article#(lf)    ,Step#(lf)    -- Single shared quantity: the Order-view unit count, used as the divisor#(lf)    -- for all three price views (per decision). Note: on articles where a CIF#(lf)    -- or FOT price is missing from some rows, that view's tail covers fewer#(lf)    -- units than QtyOrder counts, so its average is understated. As of the#(lf)    -- last check this affects Oils only (FOT gap up to ~3,368 units); BPP has#(lf)    -- no CIF prices at all so its CIF column is blank regardless.#(lf)    ,CAST(MAX(CASE WHEN PriceTypeID=1 THEN Qty END) AS decimal(19,5)) AS Qty#(lf)    ,CAST(MAX(CASE WHEN PriceTypeID=1 THEN Val END) AS decimal(19,6)) AS ValueOrderUSD#(lf)    ,CAST(MAX(CASE WHEN PriceTypeID=2 THEN Val END) AS decimal(19,6)) AS ValueCIFUSD#(lf)    ,CAST(MAX(CASE WHEN PriceTypeID=3 THEN Val END) AS decimal(19,6)) AS ValueFOTUSD#(lf)    -- audit: boundary order for the Order price view#(lf)    ,MAX(CASE WHEN PriceTypeID=1 THEN BoundaryOrderID   END) AS BoundaryOrderID#(lf)    ,MAX(CASE WHEN PriceTypeID=1 THEN BoundaryOrderDate END) AS BoundaryOrderDate#(lf)    ,MAX(CASE WHEN PriceTypeID=1 THEN BoundaryOrderCreateTime END) AS BoundaryOrderCreateTime#(lf)    ,CAST(MAX(CASE WHEN PriceTypeID=1 THEN BoundaryQtyTaken END) AS decimal(19,5)) AS BoundaryQtyTaken#(lf)    /* Step status, for the matrix:#(lf)         'Full'    - the step reached its full N units#(lf)         'Partial' - the article's entire priced history is shorter than N, so#(lf)                     Qty is the true total (e.g. 9,740 against a 10,000 step)#(lf)       A NULL boundary order is exactly the signal that the tail ran out. */#(lf)    ,CASE WHEN MAX(CASE WHEN PriceTypeID=1 THEN BoundaryOrderID END) IS NULL#(lf)          THEN 'Partial' ELSE 'Full' END AS StepStatus#(lf)    /* Row label. A partial step is labelled with its REAL total, so the axis#(lf)       reads ""Last 9,740 (all)"" rather than a ""10,000"" that was never reached. */#(lf)    ,CASE WHEN MAX(CASE WHEN PriceTypeID=1 THEN BoundaryOrderID END) IS NULL#(lf)          THEN 'Last ' + FORMAT(MAX(CASE WHEN PriceTypeID=1 THEN Qty END), 'N0') + ' (all)'#(lf)          ELSE 'Last ' + FORMAT(Step, 'N0')#(lf)     END AS StepLabel#(lf)    ,GETDATE() AS RowInsertDatetime#(lf)FROM Stepped#(lf)GROUP BY Article, Step#(lf)/* Keep every full step, plus the FIRST partial one (the article's true total).#(lf)   Without this an article with 3,394 units emits 14 identical rows from 3,500#(lf)   to 10,000, padding the matrix with repeats of the same number. */#(lf)HAVING MAX(CASE WHEN PriceTypeID=1 THEN BoundaryOrderID END) IS NOT NULL#(lf)    OR Step = (SELECT MIN(s2.Step) FROM Stepped s2#(lf)               WHERE s2.Article = Stepped.Article AND s2.PriceTypeID = 1#(lf)                 AND s2.BoundaryOrderID IS NULL)#(lf)ORDER BY Article, Step#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

